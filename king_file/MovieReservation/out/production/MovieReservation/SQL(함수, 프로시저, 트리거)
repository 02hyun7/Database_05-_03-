
/* 함수 (3개) */

DROP FUNCTION IF EXISTS fn_get_final_price; /*좌석 기준 가격 계산 함수*/
DROP FUNCTION IF EXISTS fn_apply_price_rule; /*가격규칙 적용해서 계산하는 함수*/
DROP FUNCTION IF EXISTS fn_calc_refund_amount; /*환불금액 계산하는 함수수*/

DELIMITER $$

/* 1) 좌석 기준 최종 가격 조회 함수(밑에 좌석 기준이 아닌 가격계산함수도 있음)
 *  - 입력 : 상영 ID, 좌석 ID
 *  - 동작 : seat_id -> seat_type_id 매핑 후 price 조회
 *  - 결과 : price 행이 있으면 COALESCE(changed_price, default_price), 없으면 NULL
 */
CREATE FUNCTION fn_get_final_price (
    p_show_id BIGINT,
    p_seat_id BIGINT
) RETURNS DECIMAL(10,2)
DETERMINISTIC
READS SQL DATA
BEGIN
    DECLARE v_price DECIMAL(10,2);
    DECLARE v_seat_type_id BIGINT;

    -- seat_id -> seat_type_id 조회
    SELECT seat_type_id
      INTO v_seat_type_id
      FROM seat
     WHERE seat_id = p_seat_id
     LIMIT 1;

    -- seat이 없으면 NULL 반환
    IF v_seat_type_id IS NULL THEN
        RETURN NULL;
    END IF;

    -- price 행 조회
    SELECT COALESCE(changed_price, default_price)
      INTO v_price
      FROM price
     WHERE show_id = p_show_id
       AND seat_type_id = v_seat_type_id
     LIMIT 1;

    -- price 행이 없으면 v_price는 NULL 그대로
    RETURN v_price;
END$$


/* 2) 가격 규칙 적용 함수
 *  - 입력 : base_price, rule_id
 *  - price_rule(rule_type, amount_type, amount_value, active_from/to)를 읽어 적용
 *  - 결과 : 룰이 없으면 base_price 그대로 반환
 */
CREATE FUNCTION fn_apply_price_rule (
    p_base_price DECIMAL(10,2),
    p_rule_id BIGINT
) RETURNS DECIMAL(10,2)
DETERMINISTIC
READS SQL DATA
BEGIN
    DECLARE v_rule_type    VARCHAR(255);
    DECLARE v_amount_type  VARCHAR(10);
    DECLARE v_amount_value DECIMAL(10,2);
    DECLARE v_result       DECIMAL(10,2);

    -- 해당 규칙 조회 (기간 체크 포함)
    SELECT rule_type, amount_type, amount_value
      INTO v_rule_type, v_amount_type, v_amount_value
      FROM price_rule
     WHERE rule_id = p_rule_id
       AND (active_from IS NULL OR active_from <= NOW())
       AND (active_to IS NULL OR active_to >= NOW())
     LIMIT 1;

    -- 룰이 없으면 그대로 반환
    IF v_amount_type IS NULL THEN
        RETURN p_base_price;
    END IF;

    SET v_result = p_base_price;

    IF v_amount_type = 'PERCENT' THEN
        IF v_rule_type = 'DISCOUNT' THEN
            SET v_result = p_base_price * (1 - v_amount_value / 100);
        ELSEIF v_rule_type = 'SURCHARGE' THEN
            SET v_result = p_base_price * (1 + v_amount_value / 100);
        END IF;
    ELSEIF v_amount_type = 'FIXED' THEN
        IF v_rule_type = 'DISCOUNT' THEN
            SET v_result = p_base_price - v_amount_value;
        ELSEIF v_rule_type = 'SURCHARGE' THEN
            SET v_result = p_base_price + v_amount_value;
        END IF;
    END IF;

    -- 음수 방지
    IF v_result < 0 THEN
        SET v_result = 0;
    END IF;

    RETURN v_result;
END$$


/* 3) 환불 금액 계산 함수
 *  - 기준 : 상영 시작 20분 전까지 100% 환불, 이후 0% 환불
 *  - 입력 : booking_id, cancel_time
 */
CREATE FUNCTION fn_calc_refund_amount (
    p_booking_id BIGINT,
    p_cancel_time DATETIME
) RETURNS DECIMAL(10,2)
DETERMINISTIC
READS SQL DATA
BEGIN
    DECLARE v_show_time    DATETIME;
    DECLARE v_total_amount DECIMAL(10,2);
    DECLARE v_refund       DECIMAL(10,2);

    -- 상영 시간 & 예매 총액 조회
    SELECT sh.starts_at, b.total_amount
      INTO v_show_time, v_total_amount
      FROM booking b
      JOIN showtime sh ON sh.show_id = b.show_id
     WHERE b.booking_id = p_booking_id;

    IF v_show_time IS NULL THEN
        RETURN 0;
    END IF;

    -- 환불 정책: 상영 20분 전까지는 100%, 이후는 0%
    IF p_cancel_time <= DATE_SUB(v_show_time, INTERVAL 20 MINUTE) THEN
        SET v_refund = v_total_amount;  -- 100%
    ELSE
        SET v_refund = 0;               -- no refund
    END IF;

    RETURN v_refund;
END$$

DELIMITER ;



/* 프로시저 (3개) */

DROP PROCEDURE IF EXISTS sp_cleanup_expired_hold_seat; /*만료된 hold_seat 한번에 없애는 프로시저*/
DROP PROCEDURE IF EXISTS sp_recalc_member_tier; /*회원 등급 갱신하는 프로시저*/
DROP PROCEDURE IF EXISTS sp_cancel_booking_with_refund; /*예매 취소,환불 기록 생성하는 프로시저*/

DELIMITER $$

/* 1) 만료된 hold_seat 정리 프로시저 */
CREATE PROCEDURE sp_cleanup_expired_hold_seat()
BEGIN
    DELETE FROM hold_seat
     WHERE expires_at < NOW();
END$$


/* 2) 회원 티어 재계산 프로시저
 *  - 기준 : booking.total_amount 합계와 member_tier.min_spend
 */
CREATE PROCEDURE sp_recalc_member_tier (
    IN p_member_id BIGINT
)
BEGIN
    DECLARE v_total_spend DECIMAL(10,2);
    DECLARE v_new_tier_id BIGINT;

    -- 확정된 예매(예: status='CONFIRMED')의 총 사용액 합산
    SELECT IFNULL(SUM(b.total_amount), 0)
      INTO v_total_spend
      FROM booking b
     WHERE b.member_id = p_member_id
       AND b.status = 'CONFIRMED';

    -- min_spend 조건을 만족하는 티어 중 가장 높은 티어 선택
    SELECT tier_id
      INTO v_new_tier_id
      FROM member_tier
     WHERE min_spend <= v_total_spend
     ORDER BY min_spend DESC
     LIMIT 1;

    -- 티어가 존재하면 member 갱신
    IF v_new_tier_id IS NOT NULL THEN
        UPDATE member
           SET tier_id = v_new_tier_id
         WHERE member_id = p_member_id;
    END IF;
END$$


/* 3) 예매 취소 + 환불 기록 생성 프로시저
 *  - fn_calc_refund_amount 사용
 *  - refund 레코드 생성 + booking.status='CANCELLED'
 */
CREATE PROCEDURE sp_cancel_booking_with_refund (
    IN p_booking_id BIGINT,
    IN p_reason VARCHAR(255)
)
BEGIN
    DECLARE v_refund_amount DECIMAL(10,2);
    DECLARE v_payment_id    BIGINT;

    -- 환불 금액 계산 (취소 시점 = NOW())
    SET v_refund_amount = fn_calc_refund_amount(p_booking_id, NOW());

    -- 가장 최근 결제 건을 payment_id로 사용 (없으면 NULL)
    SELECT payment_id
      INTO v_payment_id
      FROM payment
     WHERE booking_id = p_booking_id
     ORDER BY approved_at DESC, payment_id DESC
     LIMIT 1;

    -- 환불 레코드 생성 (금액이 0이여도 기록은 남긴다는 가정)
    INSERT INTO refund (booking_id, payment_id, amount, reason)
    VALUES (p_booking_id, v_payment_id, v_refund_amount, p_reason);

    -- 예매 상태 CANCELLED로 변경
    UPDATE booking
       SET status = 'CANCELLED',
           updated_at = NOW()
     WHERE booking_id = p_booking_id;
END$$

DELIMITER ;



/* 트리거 (4개) */

DROP TRIGGER IF EXISTS trg_hold_seat_after_insert; /*만료된 hold 자동 정리하는 트리거*/
DROP TRIGGER IF EXISTS trg_payment_after_insert; /*결제 후 예약 총액/상태 업데이트하고 로그 남기는 트리거*/
DROP TRIGGER IF EXISTS trg_booking_insert_audit; /*새 예매 발생할 때 로그 남기는 트리거*/
DROP TRIGGER IF EXISTS trg_booking_update_audit; /*예약 상태 및 금액 변경 시 로그 남기는 트리거*/

DELIMITER $$

/* 1) hold_seat 생성 시, 만료된 hold 자동 정리 트리거 */
CREATE TRIGGER trg_hold_seat_after_insert
AFTER INSERT ON hold_seat
FOR EACH ROW
BEGIN
    DELETE FROM hold_seat
     WHERE expires_at < NOW();
END$$


/* 2) payment 생성 시:
 *   - status='APPROVED'인 경우 booking 총액/상태 업데이트
 *   - audit_log에 결제 로그 기록
 */
CREATE TRIGGER trg_payment_after_insert
AFTER INSERT ON payment
FOR EACH ROW
BEGIN
    -- 1) 결제 승인인 경우 booking 업데이트
    IF NEW.status = 'APPROVED' THEN
        UPDATE booking b
           SET b.total_amount = (
                    SELECT IFNULL(SUM(bs.price), 0)
                      FROM booking_seat bs
                     WHERE bs.booking_id = b.booking_id
               ),
               b.status = 'CONFIRMED',
               b.updated_at = NOW()
         WHERE b.booking_id = NEW.booking_id;
    END IF;

    -- 2) 결제 행위 자체를 audit_log에 남김
    INSERT INTO audit_log (
        actor_type,
        actor_id,
        action,
        target_table,
        target_id,
        detail
    ) VALUES (
        'SYSTEM',                -- 결제 시스템/백엔드에 의해 처리된 것으로 가정
        NULL,
        'PAYMENT_INSERTED',
        'payment',
        NEW.payment_id,
        JSON_OBJECT(
            'booking_id',  NEW.booking_id,
            'method_id',   NEW.method_id,
            'amount',      NEW.amount,
            'status',      NEW.status,
            'approved_at', NEW.approved_at
        )
    );
END$$


/* 3) booking 생성 로그 트리거
 *  - 새 예매가 만들어질 때 audit_log에 BOOKING_CREATED 기록
 */
CREATE TRIGGER trg_booking_insert_audit
AFTER INSERT ON booking
FOR EACH ROW
BEGIN
    INSERT INTO audit_log (
        actor_type,
        actor_id,
        action,
        target_table,
        target_id,
        detail
    ) VALUES (
        'MEMBER',                -- 회원이 만든 예매라고 가정
        NEW.member_id,
        'BOOKING_CREATED',
        'booking',
        NEW.booking_id,
        JSON_OBJECT(
            'show_id',      NEW.show_id,
            'status',       NEW.status,
            'total_amount', NEW.total_amount,
            'created_at',   NEW.created_at
        )
    );
END$$


/* 4) booking 상태/금액 변경 로그 트리거
 *  - status 또는 total_amount가 변경될 때만 audit_log에 BOOKING_UPDATED 기록
 */
CREATE TRIGGER trg_booking_update_audit
AFTER UPDATE ON booking
FOR EACH ROW
BEGIN
    IF (OLD.status <> NEW.status) OR (OLD.total_amount <> NEW.total_amount) THEN
        INSERT INTO audit_log (
            actor_type,
            actor_id,
            action,
            target_table,
            target_id,
            detail
        ) VALUES (
            'SYSTEM',                 -- 시스템/백엔드에 의해 변경
            NEW.member_id,
            'BOOKING_UPDATED',
            'booking',
            NEW.booking_id,
            JSON_OBJECT(
                'old_status',        OLD.status,
                'new_status',        NEW.status,
                'old_total_amount',  OLD.total_amount,
                'new_total_amount',  NEW.total_amount,
                'updated_at',        NEW.updated_at
            )
        );
    END IF;
END$$

DELIMITER ;
